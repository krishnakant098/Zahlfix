# Set this in Netlify Project configuration -> Environment variables.
# Do not commit the real value.
ZAHLFIX_SETUP_KEY=replace-with-a-long-random-secret
ZAHLFIX_LINKEDIN_URL=https://www.linkedin.com/company/REPLACE-WITH-YOUR-ZAHLFIX-PAGE

# Operator-only LOCAL environment for tools/rotate-password.mjs.
# Never expose a real token to the frontend or commit it.
# NETLIFY_SITE_ID=your-authorised-site-id
# NETLIFY_AUTH_TOKEN=inject-via-secure-secret-manager
